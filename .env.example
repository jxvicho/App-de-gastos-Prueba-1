# === Requeridas para que el backend arranque ===

# Cuando corres con Docker (docker-compose up), estas dos las sobreescribe
# el propio docker-compose.yml para apuntar a los contenedores "postgres" y
# "redis" — no hace falta que las edites para esa opción.
DATABASE_URL="postgresql://app:app_password@localhost:5432/gastos_db?schema=public"
REDIS_URL="redis://localhost:6379"

PORT=4000
NODE_ENV=development

# URL donde corre este backend y URL del dashboard/frontend que lo consume.
APP_BASE_URL="http://localhost:4000"
DASHBOARD_BASE_URL="http://localhost:3000"

# Secreto para firmar los JWT de sesión. Generalo vos, no uses este valor.
JWT_SECRET="cambia-esto-por-un-valor-aleatorio-de-al-menos-16-caracteres"
JWT_EXPIRES_IN="7d"

# Clave para encriptar (AES-256-GCM) los tokens OAuth guardados en DB.
# Debe tener al menos 32 caracteres.
TOKEN_ENCRYPTION_KEY="cambia-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres"

# === Opcionales (features que puedes dejar vacías por ahora) ===

# OAuth de Gmail (Fase 2: sincronizar correos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_PUBSUB_TOPIC=

# OAuth de Microsoft / Outlook
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=

# WhatsApp Business API (bot de confirmación de gastos)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# IA para extracción/generación de contenido
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACTION=gemini-flash-latest
