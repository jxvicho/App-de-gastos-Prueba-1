// ============================================================
// SCHEMA DE BASE DE DATOS — App de gastos vía WhatsApp + correo
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// USUARIOS
// ------------------------------------------------------------

enum PetType {
  dog
  cat
  capybara
  pig
  none
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique // correo de login del producto (puede ser distinto al correo bancario)
  passwordHash String? // null si el usuario se registró solo con Google/Outlook
  phoneNumber  String?  @unique // número de WhatsApp en formato E.164, ej. +51987654321
  timezone     String   @default("America/Lima")
  currency     String   @default("PEN")
  petType      PetType  @default(dog)
  petName      String?  @default("Gastón") @db.VarChar(11)
  // Registro automático: si está activo, los movimientos detectados en el correo
  // se guardan directo (AUTO_CONFIRMED) sin pedir confirmación por WhatsApp.
  autoRegister Boolean  @default(false)
  // Plan y consentimiento de WhatsApp
  plan              Plan      @default(BASIC)
  planOverride      Plan? // plan temporal asignado desde el servidor (equipo, testers, casos puntuales)
  planOverrideUntil DateTime?
  whatsappOptIn     Boolean   @default(false) // consentimiento para recibir mensajes por WhatsApp
  dailySummaryEnabled Boolean @default(true) // solo UNLIMITED puede apagarlo; en los demás planes va activo
  dailySummaryHour  Int       @default(21) // hora (0-23, Lima) del resumen diario
  alertThreshold    Decimal?  @db.Decimal(14, 2) // PRO: avisar si un gasto es >= este monto
  lastInboundAt     DateTime? // último mensaje recibido del usuario (ventana de 24 h)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Recuperación de contraseña: se guarda el HASH del token (nunca el token
  // en claro) y su vencimiento. Un solo token activo a la vez — pedir uno
  // nuevo invalida el anterior.
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  // Relaciones
  emailAccounts     EmailAccount[]
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  categoryRules     CategoryRule[]
  recurringPayments RecurringPayment[]
  reminders         Reminder[]
  accountsCards     AccountCard[]
  whatsappSession   WhatsappSession?
  outboundMessages  OutboundMessage[]
  categoryGoals     CategoryGoal[]
  subscription      Subscription?
  debts             Debt[]
  onboarding        OnboardingState?

  @@map("users")
}

// Estado del onboarding (qué pasos ya completó, como en las capturas de Clever)
model OnboardingState {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  banksSelected      Boolean  @default(false)
  emailLinked        Boolean  @default(false)
  whatsappLinked     Boolean  @default(false)
  completedAt        DateTime?
  createdAt          DateTime @default(now())

  @@map("onboarding_states")
}

// ------------------------------------------------------------
// CORREO VINCULADO (Gmail / Outlook vía OAuth)
// ------------------------------------------------------------

enum EmailProvider {
  GMAIL
  OUTLOOK
}

model EmailAccount {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          EmailProvider
  emailAddress      String
  accessToken       String        @db.Text // encriptado a nivel de aplicación antes de guardar
  refreshToken      String        @db.Text // encriptado
  tokenExpiresAt     DateTime
  // Para Gmail: historyId del último watch procesado. Para Outlook: subscriptionId.
  syncCursor        String?
  watchExpiresAt    DateTime? // cuándo vence la suscripción push (hay que renovarla)
  isActive          Boolean       @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bankSenders BankSender[]

  @@unique([userId, emailAddress])
  @@map("email_accounts")
}

// Qué bancos/billeteras seleccionó el usuario (de qué remitentes leer)
model BankSender {
  id             String       @id @default(uuid())
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  bankKey        String // ej. "bcp", "interbank", "bbva_pe", "scotiabank_pe", "yape", "banco_ripley"
  displayName    String // ej. "BCP", "Yape"
  senderEmails   String[] // direcciones de correo que envían notificaciones de este banco
  addedManually  Boolean      @default(false) // true si el usuario añadió un correo custom no listado
  createdAt      DateTime     @default(now())

  @@unique([emailAccountId, bankKey])
  @@map("bank_senders")
}

// Catálogo de bancos soportados (referencia estática, se puede poblar con un seed)
model BankCatalog {
  id           String   @id @default(uuid())
  bankKey      String   @unique
  displayName  String
  country      String   @default("PE")
  logoUrl      String?
  senderEmails String[] // remitentes conocidos, usados para sugerir automáticamente
  isActive     Boolean  @default(true)

  @@map("bank_catalog")
}

// ------------------------------------------------------------
// TARJETAS Y CUENTAS (lo que ve el usuario en "Tarjetas / Cuentas")
// ------------------------------------------------------------

enum AccountCardType {
  DEBIT_CARD
  CREDIT_CARD
  BANK_ACCOUNT
  WALLET // Yape, Plin, etc.
}

model AccountCard {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AccountCardType
  bankKey      String
  displayName  String // ej. "BBVA Crédito", "Yape"
  lastDigits   String? // últimos 4 dígitos, si aplica
  colorHex     String? // color para UI
  isArchived   Boolean         @default(false)
  createdAt    DateTime        @default(now())

  transactions Transaction[]

  @@map("accounts_cards")
}

// ------------------------------------------------------------
// CATEGORÍAS
// ------------------------------------------------------------

model Category {
  goals CategoryGoal[]
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // ej. "Supermercado", "Delivery", "Apoyo a terceros"
  icon      String? // nombre de ícono o emoji
  colorHex  String?
  isDefault Boolean  @default(false) // true para las 25 categorías precargadas
  excludeFromTotals Boolean @default(false)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())

  transactions      Transaction[]
  budgetCategories  BudgetCategory[]
  categoryRules     CategoryRule[]

  @@unique([userId, name])
  @@map("categories")
}

// ------------------------------------------------------------
// TRANSACCIONES (el corazón del sistema)
// ------------------------------------------------------------

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransactionSource {
  EMAIL_AUTO   // detectado automáticamente leyendo el correo
  WHATSAPP_MANUAL // el usuario lo dictó por WhatsApp ("me depositaron 200 soles...")
  DASHBOARD_MANUAL // agregado a mano en el dashboard
  CSV_IMPORT   // importado desde CSV/Excel
}

enum TransactionStatus {
  PENDING_CONFIRMATION // el bot preguntó "¿lo anotamos?" y espera respuesta (ventana de 48h)
  CONFIRMED
  REJECTED
  AUTO_CONFIRMED // el usuario tiene "manos libres" activado, se guarda sin preguntar
}

model Transaction {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           TransactionType    @default(EXPENSE)
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("PEN")
  merchant       String? // "Comercio" en las capturas, ej. "AHORRAMASMARKET G"
  description    String? // ej. "Plin - Pago a Olga Huaman"
  categoryId     String?
  category       Category?          @relation(fields: [categoryId], references: [id])
  accountCardId  String?
  accountCard    AccountCard?       @relation(fields: [accountCardId], references: [id])
  bankKey        String? // por si aún no se vinculó a un AccountCard concreto
  source         TransactionSource
  status         TransactionStatus  @default(PENDING_CONFIRMATION)
  occurredAt     DateTime // fecha del gasto real (extraída del correo, no de cuándo se procesó)
  rawEmailId     String? // referencia al correo original, para trazabilidad/debug
  extractionMeta Json? // lo que devolvió el modelo de IA al parsear (para auditar/reentrenar prompts)
  confirmedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // wamid del último mensaje de notificación de WhatsApp mandado para esta
  // transacción ("¿Lo anotamos?"). Permite mapear la respuesta del usuario
  // (context.id del mensaje entrante) a esta transacción exacta, en vez de
  // asumir que se refiere a la más reciente pendiente.
  lastNotificationMessageId String?

  // Borrado lógico: si tiene fecha, el movimiento se considera "eliminado"
  // y se excluye de resúmenes/listados/identificación, pero el status
  // (ej. CONFIRMED) y el resto del historial quedan intactos y es reversible.
  deletedAt DateTime?

  @@unique([userId, rawEmailId])
  @@index([userId, occurredAt])
  @@index([userId, status])
  @@index([lastNotificationMessageId])
  @@map("transactions")
}

// ------------------------------------------------------------
// PRESUPUESTOS
// ------------------------------------------------------------

model Budget {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope        String   @default("PERSONAL") // "PERSONAL" | "EMPRESA" (como el toggle en las capturas)
  periodStart  DateTime // inicio del mes/periodo
  periodEnd    DateTime
  totalAmount  Decimal  @db.Decimal(12, 2)
  currency     String   @default("PEN")
  createdAt    DateTime @default(now())

  categories BudgetCategory[]

  // Antes no había ninguna restricción única real (la ruta la emulaba en
  // código con un findFirst) — con presupuestos separados por moneda
  // (Parte 3), un mismo usuario/periodo puede tener un Budget en PEN y otro
  // en USD, pero no dos en la MISMA moneda para el mismo periodo.
  @@unique([userId, scope, periodStart, periodEnd, currency])
  @@map("budgets")
}

model BudgetCategory {
  id         String   @id @default(uuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  amount     Decimal  @db.Decimal(12, 2) // tope asignado a esa categoría

  @@unique([budgetId, categoryId])
  @@map("budget_categories")
}

// ------------------------------------------------------------
// PAGOS RECURRENTES DETECTADOS (Netflix, Rappi Prime, etc.)
// ------------------------------------------------------------

model RecurringPayment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant      String // ej. "Netflix"
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("PEN")
  dayOfMonth    Int // día en que suele cobrarse
  isActive      Boolean  @default(true)
  lastChargedAt DateTime?
  detectedAt    DateTime @default(now())
  merchantKey   String   @default("") // comercio normalizado, para no duplicar detecciones
  source        String   @default("DETECTED") // DETECTED | MANUAL
  ignored       Boolean  @default(false) // el usuario lo quitó: no se vuelve a detectar
  categoryId    String?

  @@unique([userId, merchantKey, currency])
  @@map("recurring_payments")
}

// ------------------------------------------------------------
// REGLAS DE CATEGORIZACIÓN AUTOMÁTICA (comercio o monto -> categoría),
// creadas desde WhatsApp en lenguaje natural o desde el dashboard.
// ------------------------------------------------------------

enum RuleType {
  MERCHANT_CONTAINS
  AMOUNT_GREATER_THAN
  AMOUNT_LESS_THAN
  AMOUNT_EQUALS
}

enum RuleSource {
  WHATSAPP
  DASHBOARD
}

model CategoryRule {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       RuleType
  // MERCHANT_CONTAINS: texto a buscar en el comercio (case/tilde-insensitive).
  // AMOUNT_*: el número serializado como string, ej. "50.00" — se parsea al evaluar.
  value      String
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  isActive   Boolean    @default(true)
  source     RuleSource @default(DASHBOARD)
  createdAt  DateTime   @default(now())

  @@index([userId, isActive])
  @@map("category_rules")
}

// ------------------------------------------------------------
// RECORDATORIOS
// ------------------------------------------------------------

model Reminder {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  dueAt     DateTime
  isSent    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("reminders")
}

// ------------------------------------------------------------
// WHATSAPP
// ------------------------------------------------------------

model WhatsappSession {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  waPhoneNumberId   String // ID del número de negocio de Meta que le habla
  isHandsFree       Boolean  @default(false) // "Manos libres" — confirma automático sin preguntar
  lastMessageAt     DateTime?
  createdAt         DateTime @default(now())

  messages WhatsappMessage[]

  @@map("whatsapp_sessions")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Log de mensajes, útil para dar contexto conversacional al modelo de IA y para debug
model WhatsappMessage {
  id              String            @id @default(uuid())
  sessionId       String
  session         WhatsappSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction       MessageDirection
  content         String            @db.Text
  relatedTxnId    String? // si el mensaje fue una confirmación de gasto, referencia a la transacción
  metaMessageId   String? // ID del mensaje en la API de Meta, para tracking de entrega
  createdAt       DateTime          @default(now())

  @@index([sessionId, createdAt])
  @@map("whatsapp_messages")
}

enum Plan {
  BASIC
  PRO
  UNLIMITED
}

// Promociones: otorgan temporalmente un plan (PRO sin tope mensual) a ciertos planes.
model Promo {
  id         String   @id @default(uuid())
  name       String
  startsAt   DateTime
  endsAt     DateTime
  appliesTo  Plan[]
  grantsPlan Plan     @default(PRO)
  uncapped   Boolean  @default(true)
  budgetUsd  Decimal  @db.Decimal(12, 4)
  spentUsd   Decimal  @default(0) @db.Decimal(12, 4)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("promos")
}

// Cada mensaje que envía Gastia por WhatsApp: sirve para contar por usuario/mes/día y medir el costo real.
model OutboundMessage {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wamid       String   @unique
  kind        String // reply | txn_notification | alert | daily_summary | weekly_report | limit_notice
  isTemplate  Boolean  @default(false)
  category    String? // service | utility | marketing | authentication (lo informa Meta)
  billable    Boolean?
  pricingType String?
  costUsd     Decimal? @db.Decimal(10, 5)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("outbound_messages")
}

// Meta mensual por categoría (se repite todos los meses hasta que el usuario la cambie).
model CategoryGoal {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  currency   String   @default("PEN")
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, currency])
  @@map("category_goals")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// Suscripción del usuario. Todavía no hay pasarela de pagos: se asigna a mano (admin/base de datos)
// y los campos del método de pago quedan listos para cuando se integre.
model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             SubscriptionStatus @default(TRIALING)
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime? // próxima fecha de cobro
  cancelAtPeriodEnd  Boolean            @default(false)
  paymentBrand       String? // visa | mastercard | ...
  paymentLast4       String?
  paymentExpMonth    Int?
  paymentExpYear     Int?
  billingName        String?
  billingDocType     String? // DNI | RUC | CE
  billingDocNumber   String?
  billingEmail       String?
  billingAddress     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("subscriptions")
}

// ------------------------------------------------------------
// DEUDAS: por cobrar (RECEIVABLE, me deben) y por pagar (PAYABLE, debo),
// con abonos parciales y fecha de vencimiento opcional.
// ------------------------------------------------------------
model Debt {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction    String // RECEIVABLE | PAYABLE
  counterparty String // persona o entidad
  concept      String? // motivo
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("PEN")
  dueDate      DateTime?
  phone        String? // para recordar por WhatsApp (solo por cobrar)
  settledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  payments     DebtPayment[]

  @@index([userId, direction])
  @@map("debts")
}

model DebtPayment {
  id        String   @id @default(uuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  @@index([debtId])
  @@map("debt_payments")
}
